  "orphanedBytes": 11812,
  "orphanFinding": {
    "summary": "12 tracked files under runtime-profiles/ are referenced by no profile_file! call site, so they are never compiled in and never materialize on a device.",
    "pattern": "the same 3 paths in each of the 4 non-react-dom families",
    "paths": [
      "app/screens/detail-screen.jsx",
      "app/screens/home-screen.jsx",
      "src/stores/app-store.js"
    ],
    "reactDomReferencesThem": "yes, local_app_runtime_profiles.rs:55-57",
    "areTheyImportedByShippedFiles": "no. canvas-2d's shipped lib/platform-adapter.js:48 and lib/lingxi-provider.jsx:119 mention home-screen.jsx only in comments ('They used to be spread onto the root element of ...'), not in imports.",
    "verdict": "dead scaffold, left behind when the non-react-dom families dropped the routed-screen layout",
    "whyItMatters": "A migration driven by 'copy the tracked files under runtime-profiles/' carries 12 dead files into the plugin package; one driven by the 112 macro call sites does not. The two strategies differ by exactly these files and neither would report the disagreement. This is why the packer must be inventory-driven from the call sites (§19.2, P1.2), and why this manifest is generated now rather than after files have started moving."
  }
