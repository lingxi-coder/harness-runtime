    "agent_model_canonicalizer": {
      "vectors": [
        {
          "input": "  CuStOm-ClAuDe-MoDeL  ",
          "actual": "CuStOm-ClAuDe-MoDeL",
          "expected": "CuStOm-ClAuDe-MoDeL",
          "label": "trim but preserve non-alias casing"
        },
        {
          "input": "FABLE",
          "actual": "native-fable-default",
          "expected": "native-fable-default",
          "label": "Fable alias resolves through configured default"
        },
        {
          "input": "OPUS",
          "actual": "native-opus-default",
          "expected": "native-opus-default",
          "label": "case-insensitive Opus alias"
        },
        {
          "input": "SoNnEt",
          "actual": "native-sonnet-default",
          "expected": "native-sonnet-default",
          "label": "case-insensitive Sonnet alias"
        },
        {
          "input": "HAIKU",
          "actual": "native-haiku-default",
          "expected": "native-haiku-default",
          "label": "case-insensitive Haiku alias"
        },
        {
          "input": "opusplan",
          "actual": "native-sonnet-default",
          "expected": "native-sonnet-default",
          "label": "opusplan chooses Sonnet outside plan-mode runtime"
        },
        {
          "input": "BEST[1m]",
          "actual": "native-best-from-catalog",
          "expected": "native-best-from-catalog",
          "label": "best alias ignores explicit 1m suffix"
        },
        {
          "input": "OPUS[1M]",
          "actual": "native-opus-default[1m]",
          "expected": "native-opus-default[1m]",
          "label": "1m Opus alias resolves then restores suffix"
        },
        {
          "input": "CLAUDE-OPUS-4-1-20250805",
          "actual": "native-opus-default",
          "expected": "native-opus-default",
          "label": "first-party legacy Opus remap enabled"
        },
        {
          "input": "CLAUDE-OPUS-4-1-20250805",
          "actual": "CLAUDE-OPUS-4-1-20250805",
          "expected": "CLAUDE-OPUS-4-1-20250805",
          "label": "legacy remap disable flag preserves explicit id"
        },
        {
          "input": "CLAUDE-OPUS-4-1-20250805",
          "actual": "CLAUDE-OPUS-4-1-20250805",
          "expected": "CLAUDE-OPUS-4-1-20250805",
          "label": "legacy remap is first-party-only"
        },
        {
          "input": "OPUS[1m]",
          "actual": "OPUS[1m]",
          "expected": "OPUS[1m]",
          "label": "disabled 1m context leaves suffixed alias spelling untouched"
        },
        {
          "input": "Custom-Model[2m]",
          "actual": "Custom-Model[2m]",
          "expected": "Custom-Model[2m]",
          "label": "At does not strip or reinterpret 2m suffix"
        },
        {
          "input": "Claude-Fable-4-6[1m]",
          "actual": "Claude-Fable-4-6",
          "expected": "Claude-Fable-4-6",
          "label": "enabled native 1m Fable context removes explicit suffix"
        },
        {
          "input": "Claude-Fable-4-6[1m]",
          "actual": "Claude-Fable-4-6[1m]",
          "expected": "Claude-Fable-4-6[1m]",
          "label": "unsupported native 1m Fable context keeps suffix"
        }
      ],
