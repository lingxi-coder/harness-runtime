+    alias_source_units: &[u16],
+) -> Option<Vec<u16>> {
+    aliases?
+        .object_entries()?
+        .into_iter()
+        .find(|entry| entry.code_units == alias_source_units)
+        .and_then(|entry| entry.value.code_units().map(<[u16]>::to_vec))
