+                    && native_rule_content_matches_alias_source(
+                        rule_tool_name,
+                        behavior,
+                        content,
+                        alias,
+                    ))
+                    || (rule_tool_name == canonical_tool_name
+                        && String::from_utf16(alias).is_ok_and(|alias_name| {
+                            native_rule_content_matches_alias_source(
+                                &alias_name,
+                                behavior,
+                                content,
+                                alias,
