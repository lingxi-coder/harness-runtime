+        && row.workspace_path.as_deref() == b.to_str()));
+    assert!(rows.iter().any(|row| row.uuid == z));
+    assert!(
+        !rows.iter().any(|row| row.uuid == y),
+        "the rest of A's bucket must not appear in B"
+    );
+    let found = find_session_in_scope_with_diagnostics(
