+    async fn validate(&self, fs: &dyn FileSystem) -> Result<(), String> {
+        self.lock
+            .validate_current()
+            .map_err(|error| error.to_string())?;
+        if fs
+            .root_identity_no_follow(&self.scope_root)
+            .await
+            .map_err(|error| error.to_string())?
+            != self.scope_identity
+            || fs
+                .root_identity_no_follow(&self.state_root)
+                .await
+                .map_err(|error| error.to_string())?
+                != self.state_identity
