+    let before = second
+        .runtime()
+        .block_on(async { second.inner().orchestrator.current_session_id().await });
+    second.runtime().block_on(async {
+        let error = second
+            .resume_seeded_test_session(first_id.as_uuid().to_string())
+            .await
