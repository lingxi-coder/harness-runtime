+    release: Option<tokio::sync::oneshot::Receiver<()>>,
+}
+
+#[async_trait]
+impl RealtimeSink for PausedInputSink {
+    async fn send(&mut self, frame: RealtimeFrame) -> Result<(), RealtimeError> {
+        let is_input = match frame {
+            RealtimeFrame::Text(bytes) => serde_json::from_slice::<serde_json::Value>(&bytes).ok()
+                .and_then(|value| value.get("type").and_then(|kind| kind.as_str()).map(str::to_owned))
+                .as_deref() == Some("conversation.item.create"),
+            _ => false,
+        };
+        if is_input {
+            if let Some(begun) = self.begun.take() { let _ = begun.send(()); }
+            if let Some(release) = self.release.take() { let _ = release.await; }
+        }
+        Ok(())
+    }
+    async fn ping(&mut self, _: bytes::Bytes) -> Result<(), RealtimeError> { Ok(()) }
+    fn abort(&mut self) {}
+    async fn close(&mut self, _: RealtimeClose) -> Result<(), RealtimeError> { Ok(()) }
+}
