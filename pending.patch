+
+impl ResponseAttribution {
+    fn request(
+        &mut self,
+        control: &RealtimeControl,
+        input: RealtimeInput,
+        fence_id: Option<u64>,
+    ) -> Result<(), OrchestratorError> {
+        if self.pending_tag.is_some() {
+            return Err(failure("realtime response request is already pending"));
+        }
+        let tag = uuid::Uuid::new_v4().to_string();
+        control.send_with_response_tag(input, &tag, fence_id)
+            .map_err(|error| failure(error.to_string()))?;
+        self.pending_tag = Some(tag);
+        Ok(())
+    }
+
+    /// Return false only for a frame belonging to a previously retired response.
+    fn accepts(
+        &mut self,
+        event: &RealtimeEvent,
+        origin: Option<&RealtimeResponseOrigin>,
+        local_turn_active: bool,
+    ) -> Result<bool, OrchestratorError> {
+        if !self.enabled { return Ok(true); }
+        if matches!(event, RealtimeEvent::TurnStarted { .. }) {
+            let origin = origin.ok_or_else(|| failure("realtime response has no provider identity"))?;
+            if !local_turn_active || self.active_id.is_some() || origin.response_id.is_empty()
+                || self.retired_ids.contains(&origin.response_id)
+                || self.pending_tag.as_deref() != origin.request_tag.as_deref()
+                || self.pending_tag.is_none()
+            {
+                return Err(failure("realtime response does not match a pending host request"));
+            }
+            self.pending_tag = None;
+            self.active_id = Some(origin.response_id.clone());
+            return Ok(true);
+        }
+        if let Some(origin) = origin {
+            if self.retired_ids.contains(&origin.response_id) { return Ok(false); }
+            if self.active_id.as_deref() != Some(origin.response_id.as_str()) {
+                return Err(failure("realtime event has an unbound response identity"));
+            }
+            // The raw event is the final projection of the same response.done
+            // frame; keep the binding through its usage and cancellation events.
+            if matches!(event, RealtimeEvent::ProviderEvent { name, .. } if name == "response.done") {
+                self.retired_ids.insert(origin.response_id.clone());
+                self.active_id = None;
+            }
+            return Ok(true);
+        }
+        if matches!(event,
+            RealtimeEvent::ToolCall { .. } | RealtimeEvent::ToolCancelled { .. }
+            | RealtimeEvent::Interrupted | RealtimeEvent::TurnCompleted { .. }
+            | RealtimeEvent::AudioDelta { .. } | RealtimeEvent::TextDelta { .. }
+            | RealtimeEvent::Usage { .. }
+            | RealtimeEvent::Transcript { direction: RealtimeTranscriptDirection::Output, .. }
+        ) || matches!(event, RealtimeEvent::ProviderEvent { name, .. } if name.starts_with("response.")) {
+            return Err(failure("realtime response event lacks a provider identity"));
+        }
+        Ok(true)
+    }
+}
