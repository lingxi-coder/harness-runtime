+                payload.push_str(&line);
+                payload.push('\n');
+                let _identity_guard = self
+                    .prepare_metadata_identity_non_durable(&target.0)
+                    .await?;
+                self.append_payload_to_path(&target.0, &payload, true)
+                    .await?;
+            }
+        }
+        Ok(())
+    }
