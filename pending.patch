+        config.clone(),
+        platform.clone(),
+        Arc::new(FakeListener::default()),
+        Arc::new(RecordingPermissionSink::default()),
+    );
+    let error = match duplicate {
+        Ok(_) => panic!("two engines must not own one conversation"),
+        Err(error) => error,
