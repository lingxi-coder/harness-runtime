+        .unwrap();
+    assert_eq!(capture.transcript_path, authority.path());
+    assert_eq!(capture.source.as_bytes(), authority.read_checked().unwrap());
+    assert!(capture.source.contains("fresh desktop prompt"));
+    drop(lease);
+    assert!(
+        runtime
+            .session_lifecycle
+            .shutdown_and_drain()
+            .await
+            .complete
+    );
+}
