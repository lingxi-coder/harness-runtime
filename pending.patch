+#[tokio::test]
+async fn old_openai_tool_after_local_send_marker_never_executes() {
+    use lingxi_llm_client::providers::openai::realtime::{OpenAiRealtimeCodec, OpenAiRealtimeConfig};
+    for blocked_send in [false, true] {
+        let gate = Arc::new(Gate { calls: AtomicUsize::new(0), deny: false, release: None, approved: AtomicBool::new(false) });
+        let (orch, calls) = fixture(gate.clone()).await;
+        let prepared = prepare_bound(&orch).await;
+        let (incoming_tx, incoming_rx) = futures::channel::mpsc::unbounded();
+        let (begun_tx, begun_rx) = tokio::sync::oneshot::channel();
+        let (release_tx, release_rx) = tokio::sync::oneshot::channel();
+        let inbound: futures::stream::BoxStream<'static, Result<RealtimeFrame, RealtimeError>> = if blocked_send {
+            incoming_rx.boxed()
+        } else {
+            PendingOnceOldTool(0).boxed()
+        };
+        let outbound: Box<dyn RealtimeSink> = if blocked_send {
+            Box::new(PausedInputSink { begun: Some(begun_tx), release: Some(release_rx) })
+        } else {
+            Box::new(Sink(Arc::new(std::sync::Mutex::new(vec![]))))
+        };
+        let transport = ScriptedTransport(std::sync::Mutex::new(Some(RealtimeConnection { inbound, outbound })));
+        let codec = OpenAiRealtimeCodec::new(OpenAiRealtimeConfig { manual_turns: true, ..Default::default() });
+        let (session, driver) = RealtimeSession::connect(&transport, RealtimeConnectRequest {
+            endpoint: "wss://fixture".into(), headers: vec![], max_frame_bytes: 4096,
+        }, Arc::new(codec), RealtimeLimits::default()).await.unwrap();
+        let (control, events) = session.into_parts();
+        let (input_tx, inputs) = mpsc::channel(8);
+        input_tx.try_send(RealtimeAgentInput::Provider(RealtimeInput::Text("new input".into()))).unwrap();
+        let (output, mut output_rx) = mpsc::channel(32);
+        let task = tokio::spawn({ let orch = orch.clone(); async move {
+            orch.run_realtime_agent(prepared, control, events, inputs, output, Default::default(), false, CancellationToken::new()).await
+        }});
+        wait_until(|| input_tx.capacity() == 8, "host enqueued fenced text before driver starts").await;
+        let driver = tokio::spawn(driver.run());
+        if blocked_send {
+            tokio::time::timeout(Duration::from_secs(2), begun_rx).await.unwrap().unwrap();
+            incoming_tx.unbounded_send(Ok(old_openai_tool())).unwrap();
+            release_tx.send(()).unwrap();
+        }
+        let error = tokio::time::timeout(Duration::from_secs(2), task).await.unwrap().unwrap().unwrap_err();
+        assert!(error.to_string().contains("unbound response identity"), "{error}");
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+        assert_eq!(gate.calls.load(Ordering::SeqCst), 0);
+        let mut started = false;
+        while let Ok(event) = output_rx.try_recv() {
+            started |= matches!(event, RealtimeAgentOutput::AgentResponseStarted { .. });
+            assert!(!matches!(event, RealtimeAgentOutput::Provider(RealtimeEvent::ToolCall { .. })));
+        }
+        assert!(started, "the stale frame crossed the local send marker");
+        let _ = driver.await;
+    }
+}
