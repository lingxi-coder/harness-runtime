+// The old frame is retained behind a legal Pending poll. A self-wake cannot
+// make the local send marker evidence that the frame belongs to the new input.
+struct PendingOnceOldTool(u8);
+impl futures::Stream for PendingOnceOldTool {
+    type Item = Result<RealtimeFrame, RealtimeError>;
+    fn poll_next(mut self: std::pin::Pin<&mut Self>, cx: &mut std::task::Context<'_>) -> std::task::Poll<Option<Self::Item>> {
+        match self.0 {
+            0 => { self.0 = 1; cx.waker().wake_by_ref(); std::task::Poll::Pending }
+            1 => { self.0 = 2; std::task::Poll::Ready(Some(Ok(old_openai_tool()))) }
+            _ => std::task::Poll::Pending,
+        }
+    }
+}
