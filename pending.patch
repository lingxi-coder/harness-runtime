+            if let Some(node) = after.map.get(&key) {
+                self.map.insert(key, node.clone());
+            } else {
+                self.map.remove(&key);
+            }
+        }
+        self.total_bytes = self.map.values().map(|node| node.size).sum();
+        self.clock = self.clock.max(after.clock);
