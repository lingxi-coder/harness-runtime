      "source": "var wEt=\"claude/endTurn\";function vEt(e){return e?._meta?.[wEt]===!0}function dEo(e){if(e.type!==\"user\")return!1;let n=e.toolEndsTurn?\"tool\":vEt(e.mcpMeta)?\"mcp_meta\":!1;if(!n)return!1;let r=e.message.content;if(Array.isArray(r)&&r.some((s)=>s.type===\"tool_result\"&&s.is_error===!0))return!1;return n}"
