{
  "removalsWithWorkingDirs": [
    {
      "target": "/other/deep/*",
      "cwd": "/home/user/project",
      "home": "/home/user",
      "workingDirs": [
        "/other/deep"
      ],
      "expected": {
        "behavior": "ask",
        "message": "Dangerous rm operation detected: '/other/deep/*'\n\nThis command would remove a workspace directory (the working directory, an additional working directory, or one of their parent directories). This requires explicit approval and cannot be auto-allowed by permission rules.",
        "reason": "on working directory or its ancestor: /other/deep/*"
      }
    },
    {
      "target": "/other/deep/sub/*",
      "cwd": "/home/user/project",
      "home": "/home/user",
      "workingDirs": [
        "/other/deep"
      ],
      "expected": {
        "behavior": "passthrough",
        "message": "No dangerous removals detected for rm command"
      }
    },
    {
      "target": "/other/deep",
      "cwd": "/home/user/project",
      "home": "/home/user",
      "workingDirs": [
        "/other/deep"
      ],
      "expected": {
        "behavior": "passthrough",
        "message": "No dangerous removals detected for rm command"
      }
    }
  ],
