{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/local-app/workflow-agent-results.schema.json",
  "title": "Local App workflow agent results",
  "description": "Checked-in role-output contracts. QA completion is represented by Host-issued candidate identities and receipts, never model-authored pass flags.",
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 256 },
    "qa_handle": { "type": "string", "pattern": "^qa_[A-Za-z0-9]{32}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "blocking": { "type": "boolean" },
        "resolved_by_evidence_ids": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/token" } }
      },
      "required": ["id", "message", "blocking", "resolved_by_evidence_ids"]
    },
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": { "enum": ["react_dom", "canvas_2d", "three_3d", "phaser_2d", "babylon_3d"] },
        "revision": { "type": "integer", "minimum": 1 },
        "contractSha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["family", "revision", "contractSha256"]
    },
    "qa_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_id": { "$ref": "#/$defs/token" },
        "workflow_run_id": { "$ref": "#/$defs/token" },
        "qa_handle": { "$ref": "#/$defs/qa_handle" },
        "build_id": { "$ref": "#/$defs/token" },
        "runtime_profile": { "$ref": "#/$defs/runtime_profile" },
        "verification_strategy": { "enum": ["fast", "balanced", "thorough"] },
        "dependency_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "authoring_contract_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_revision": { "type": "integer", "minimum": 1 },
        "runtime_generation": { "type": "integer", "minimum": 1 }
      },
      "required": ["app_id", "workflow_run_id", "qa_handle", "build_id", "runtime_profile", "verification_strategy", "dependency_snapshot_sha256", "authoring_contract_sha256", "manifest_revision", "runtime_generation"]
    },
    "verification_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "in_scope_target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "unverified_target_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "unverified_scenario_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
      },
      "required": ["declared_target_ids", "in_scope_target_ids", "unverified_target_ids", "unverified_scenario_ids"]
    },
    "upstream_failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "introduced_at_ms": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "message", "introduced_at_ms"]
    },
    "scenario_judgement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_id": { "$ref": "#/$defs/token" },
        "status": { "enum": ["passed", "failed"] },
        "evidence_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/token" } },
        "summary": { "type": "string", "maxLength": 16384 }
      },
      "required": ["scenario_id", "status", "evidence_ids", "summary"]
    },
    "qa_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": { "$ref": "#/$defs/token" },
        "app_id": { "$ref": "#/$defs/token" },
        "workflow_run_id": { "$ref": "#/$defs/token" },
        "qa_handle": { "$ref": "#/$defs/qa_handle" },
        "result_id": { "$ref": "#/$defs/token" },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "issued_at_ms": { "type": "integer", "minimum": 1 }
      },
      "required": ["receipt_id", "app_id", "workflow_run_id", "qa_handle", "result_id", "identity_sha256", "result_sha256", "issued_at_ms"]
    },
    "qa_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "status": { "const": "candidate" },
        "identity": { "$ref": "#/$defs/qa_identity" },
        "scenario_judgements": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/scenario_judgement" } },
        "findings": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/finding" } },
        "evidence": { "type": "array", "maxItems": 4096 },
        "verification_scope": { "$ref": "#/$defs/verification_scope" },
        "previous_result_id": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "finalized_at_ms": { "type": "integer", "minimum": 1 },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["schema_version", "status", "identity", "scenario_judgements", "findings", "evidence", "verification_scope", "previous_result_id", "finalized_at_ms", "result_sha256"]
    },
    "operator_result": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": { "const": true },
            "qa_handle": { "$ref": "#/$defs/qa_handle" },
            "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
            "status": { "type": "string" }, "issues": { "type": "array" }, "summary": { "type": "string" },
            "verification_scope": { "$ref": "#/$defs/verification_scope" },
            "declared_target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
            "target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
            "unverified_target_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
            "unverified_scenario_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
            "upstream_failures": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/upstream_failure" } },
            "upstream_findings": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/finding" } }
          },
          "required": ["qa_handle", "evidence_ids", "status", "issues", "verification_scope", "upstream_failures", "upstream_findings"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "ok": { "const": false }, "error": { "type": "string", "minLength": 1, "maxLength": 16384 }, "status": { "const": "infrastructure_failed" }, "summary": { "type": "string" } },
          "required": ["ok", "error"]
        }
      ]
    },
    "qa_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qa_handle": { "$ref": "#/$defs/qa_handle" },
        "scenario_judgements": { "type": "array", "items": { "$ref": "#/$defs/scenario_judgement" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "summary": { "type": "string" }
      },
      "required": ["qa_handle", "scenario_judgements", "findings"]
    },
    "qa_finalize": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "ok": { "type": "boolean" }, "status": { "const": "candidate" }, "receipt": { "$ref": "#/$defs/qa_receipt" }, "result": { "$ref": "#/$defs/qa_candidate" } },
          "required": ["ok", "status", "receipt", "result"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["evidence_resample_required", "infrastructure_failed"] },
            "qa_handle": { "$ref": "#/$defs/qa_handle" },
            "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
            "summary": { "type": "string", "minLength": 1 }
          },
          "required": ["status", "qa_handle", "findings", "summary"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "ok": { "const": false }, "error": { "type": "string", "minLength": 1, "maxLength": 16384 }, "summary": { "type": "string" } },
          "required": ["ok", "error"]
        }
      ]
    },
    "mcp_promoter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promoted": { "type": "boolean" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/token" },
        "publication_state": { "$ref": "#/$defs/token" }
      },
      "required": ["promoted", "catalog_sha256", "status", "publication_state"]
    }
  }
}
