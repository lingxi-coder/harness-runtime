{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/local-app/authoring-spec.schema.json",
  "title": "Local App authoring spec",
  "description": "Closed model-authored intent. Host identity, runtime profile and build provenance are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "tasks": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
        "external_integrations": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } }
      },
      "required": ["goal", "tasks", "external_integrations"]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[a-z][a-z0-9-]*$" },
          "os": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "form_factor": { "type": "string", "minLength": 1, "maxLength": 16384 }
        },
        "required": ["id", "os", "form_factor"]
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "type": "string", "minLength": 1, "maxLength": 16384 }, "accent": { "type": "string", "minLength": 1, "maxLength": 16384 } },
          "required": ["mode", "accent"]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "direction": { "type": "string", "minLength": 1, "maxLength": 16384 }, "density": { "type": "string", "minLength": 1, "maxLength": 16384 } },
          "required": ["direction", "density"]
        },
        "references": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } }
      },
      "required": ["structure", "theme", "style", "references"]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presentations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "target_id": { "type": "string", "minLength": 1, "maxLength": 16384 },
              "presentation": { "type": "string", "minLength": 1, "maxLength": 16384 },
              "navigation": { "type": "string", "minLength": 1, "maxLength": 16384 }
            },
            "required": ["target_id", "presentation", "navigation"]
          }
        },
        "tokens": { "type": "object", "maxProperties": 128, "propertyNames": { "minLength": 1, "maxLength": 16384 }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 16384 } },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loading": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "empty": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "error": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "success": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "permission": { "type": "string", "minLength": 1, "maxLength": 16384 }
          },
          "required": ["loading", "empty", "error", "success", "permission"]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pointer_touch": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
            "keyboard_mouse": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
            "back": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "reduced_motion": { "type": "string", "minLength": 1, "maxLength": 16384 }
          },
          "required": ["pointer_touch", "keyboard_mouse", "back", "reduced_motion"]
        },
        "canvas": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "scene": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "phases": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
            "controls": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
            "hud": { "type": "string", "minLength": 1, "maxLength": 16384 }
          },
          "required": ["scene", "phases", "controls", "hud"]
        }
      },
      "required": ["presentations", "tokens", "states", "inputs"]
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[a-z][a-z0-9-]*$" } },
          "required": { "type": "boolean" },
          "preconditions": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
          "steps": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
          "expected": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["inspect", "ui_action", "capture"] } },
          "motion_required": { "type": "boolean", "default": false }
        },
        "required": ["id", "target_ids", "required", "preconditions", "steps", "expected", "evidence"],
        "allOf": [{
          "if": { "properties": { "motion_required": { "const": true } }, "required": ["motion_required"] },
          "then": { "properties": { "evidence": { "contains": { "const": "capture" } } } }
        }]
      },
      "contains": { "type": "object", "properties": { "required": { "const": true } }, "required": ["required"] },
      "minContains": 1
    }
  },
  "required": ["product", "targets", "ui", "design", "acceptance_checks"],
  "$defs": {}
}
