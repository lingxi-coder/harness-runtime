{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/local-app/mcp-proposal.schema.json",
  "title": "AppMcpProposal",
  "description": "Exact agent-owned JSON shape accepted by the Host AppMcpProposal DTO. Host-owned catalog, approval, execution and permission fields are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "appId": { "$ref": "#/$defs/token" },
    "manifestRevision": { "type": "integer", "minimum": 0 },
    "userGoalSha256": { "$ref": "#/$defs/sha256" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "tools": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool" }
    },
    "requiredFlowChanges": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 16384 }
    },
    "excludedCapabilities": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 16384 }
    }
  },
  "required": ["appId", "manifestRevision", "userGoalSha256", "summary", "tools", "requiredFlowChanges", "excludedCapabilities"],
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "json_schema": { "type": "object" },
    "flow_value_binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "literal": {} },
          "required": ["literal"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_input": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "json_pointer": { "type": "string", "maxLength": 512 } },
              "required": ["json_pointer"]
            }
          },
          "required": ["tool_input"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "step_output": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "step_id": { "$ref": "#/$defs/token" },
                "json_pointer": { "type": "string", "maxLength": 512 }
              },
              "required": ["step_id", "json_pointer"]
            }
          },
          "required": ["step_output"]
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": { "type": ["string", "null"], "maxLength": 100 },
        "description": { "type": ["string", "null"], "maxLength": 1000 },
        "inputSchema": { "$ref": "#/$defs/json_schema" },
        "outputSchema": {
          "anyOf": [{ "$ref": "#/$defs/json_schema" }, { "type": "null" }]
        },
        "semanticFlowId": { "$ref": "#/$defs/token" },
        "inputs": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/flow_value_binding" }
        },
        "result": { "$ref": "#/$defs/flow_value_binding" }
      },
      "required": ["name", "inputSchema", "semanticFlowId", "result"]
    }
  }
}
