{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/local-app/use-test-report.schema.json",
  "title": "Local App use-test role report",
  "description": "Compact use-test workflow output. Host identity and raw evidence are verified through the local-apps core ledger, never by this report alone.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "build_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "runtime_profile_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": { "enum": ["react_dom", "canvas_2d", "three_3d", "phaser_2d", "babylon_3d"] },
        "revision": { "type": "integer", "minimum": 1 },
        "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["family", "revision", "contract_sha256"]
    },
    "verification_policy": { "enum": ["dom", "canvas_2d", "three_3d", "phaser_2d", "babylon_3d"] },
    "scenario_results": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/judgement" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "status": { "enum": ["passed", "failed"] },
              "evidence": { "type": "string", "maxLength": 16384 }
            },
            "required": ["name", "status", "evidence"]
          }
        ]
      }
    },
    "render_check": { "$ref": "#/$defs/render_check" },
    "motion_check": { "$ref": "#/$defs/motion_check" },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "console": { "type": "array", "items": { "type": "string", "maxLength": 16384 } },
        "errors": { "type": "array", "items": { "type": "string", "maxLength": 16384 } },
        "runtime_or_build_logs": { "type": "array", "items": { "type": "string", "maxLength": 16384 } }
      },
      "required": ["console", "errors", "runtime_or_build_logs"]
    },
    "bridge_data_roundtrip": { "$ref": "#/$defs/data_roundtrip" },
    "evidence_handles": { "type": "array", "maxItems": 4096, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "evidence": { "type": "object" },
    "verification_scope": { "$ref": "#/$defs/verification_scope" }
  },
  "required": ["app_id", "build_id", "runtime_profile_contract", "verification_policy", "scenario_results", "render_check", "logs", "bridge_data_roundtrip", "evidence_handles"],
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 256 },
    "judgement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_id": { "$ref": "#/$defs/token" },
        "status": { "enum": ["passed", "failed"] },
        "evidence_ids": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/token" } },
        "summary": { "type": "string", "minLength": 1, "maxLength": 16384 }
      },
      "required": ["scenario_id", "status", "evidence_ids", "summary"]
    },
    "data_roundtrip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "not_applicable", "failed"] },
        "collections": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/token" } },
        "evidence": { "type": "string", "maxLength": 16384 }
      },
      "required": ["status", "collections", "evidence"]
    },
    "render_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "not_applicable", "failed"] },
        "canvas_surfaces": { "type": "integer", "minimum": 0 },
        "frames_captured": { "type": "integer", "minimum": 0 },
        "interactions_driven": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 16384 } },
        "evidence": { "type": "string", "maxLength": 16384 }
      },
      "required": ["status", "canvas_surfaces", "frames_captured", "interactions_driven", "evidence"]
    },
    "motion_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "frames_compared": { "type": "integer", "minimum": 0 },
        "difference": { "type": "string", "maxLength": 16384 }
      },
      "required": ["status", "frames_compared", "difference"]
    },
    "verification_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "in_scope_target_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "unverified_target_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "unverified_scenario_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
      },
      "required": ["declared_target_ids", "in_scope_target_ids", "unverified_target_ids", "unverified_scenario_ids"]
    }
  }
}
